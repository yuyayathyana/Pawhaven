
@inject Microsoft.AspNetCore.Identity.UserManager<Pawhaven.Models.ApplicationUser> UserManager

@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;

    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser.FullName
        : currentUser?.UserName ?? "there";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pawhaven</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Pawhaven.styles.css" asp-append-version="true" />
</head>

<body class="pawhaven-body">

    <header>
        <nav class="navbar navbar-expand-lg pawhaven-navbar">
            <div class="container">

                <a class="navbar-brand pawhaven-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-paw">🐾</span>
                    Pawhaven
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto pawhaven-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Staff"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Staff"
                                       asp-action="Bookings">
                                        Bookings
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Staff"
                                       asp-action="Pets">
                                        View Pets
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="CustomerServices"
                                       asp-action="Index">
                                        Grooming Services
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="CustomerPets"
                                       asp-action="Index">
                                        My Pets
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="CustomerBookings"
                                       asp-action="Index">
                                        My Bookings
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link guest-quote">
                                    "Where every paw feels at home."
                                </span>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-2">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="welcome-text">
                                    Hello, @displayName!
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn pawhaven-logout">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn pawhaven-login"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pawhaven-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="pawhaven-footer">
        <div class="container text-center">
            <p class="mb-1">
                <span>🐾</span> Pawhaven
            </p>

            <small>
                Where every paw feels at home.
                © 2026 Pawhaven. All rights reserved.
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
