
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pawhaven Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>

<body class="admin-body">

    <nav class="navbar navbar-expand-lg admin-navbar">
        <div class="container-fluid px-4">

            <a class="navbar-brand fw-bold admin-brand" href="/Admin">
                🐾 Pawhaven <span>Admin</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminNavigation"
                    aria-controls="adminNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavigation">

                <ul class="navbar-nav me-auto admin-nav">

                    <li class="nav-item">
                        <a class="nav-link" href="/Admin">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Users">Users</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Pets">Pets</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/GroomingServices">Services</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Bookings">Bookings</a>
                    </li>

                </ul>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="admin-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn admin-logout">
                        Logout
                    </button>

                </form>

            </div>
        </div>
    </nav>

    <main class="container-fluid admin-main">
        @RenderBody()
    </main>

    <footer class="admin-footer">
        <p>🐾 Pawhaven Admin · Caring for every paw</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-search.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
